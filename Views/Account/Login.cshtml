@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>DocGenie - Login</title>


    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />


    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />


    <!-- DocGenie Landing -->
    <link rel="stylesheet"
          href="~/css/landing.css"
          asp-append-version="true" />

</head>


<body>


    <!-- =====================================================
         BACKGROUND
         ===================================================== -->

    <div class="background">


        <!-- Main background gradient -->

        <div class="background-gradient"></div>

        <div class="background-blue-wash"></div>


        <!-- Decorative circles -->

        <div class="bg-circle bg-circle-top"></div>

        <div class="bg-circle bg-circle-bottom-left"></div>

        <div class="bg-circle bg-circle-bottom-right"></div>


        <!-- Curved lines -->

        <div class="orbit orbit-one"></div>

        <div class="orbit orbit-two"></div>

        <div class="orbit orbit-three"></div>


        <!-- =================================================
             LEFT DOT GRID
             ================================================= -->

        <div class="dot-grid dot-grid-left">

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

        </div>


        <!-- =================================================
             RIGHT DOT GRID
             ================================================= -->

        <div class="dot-grid dot-grid-right">

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>

        </div>


        <!-- Ambient lights -->

        <div class="ambient-light ambient-light-one"></div>

        <div class="ambient-light ambient-light-two"></div>


    </div>



    <!-- =====================================================
         PAGE
         ===================================================== -->

    <div class="page">


        <!-- =================================================
             TOP NAVIGATION
             ================================================= -->

        <header class="top-nav">


            <!-- Brand -->

            <div class="brand">

                <div class="brand-icon">

                    <i class="fas fa-file-alt"></i>

                </div>

                <span>
                    DocGenie
                </span>

            </div>


            <!-- Center title -->

            <div class="portal-title">

                Welcome to DocGenie

            </div>


            <!-- Right -->

            <div class="contact">

                <i class="fas fa-headset"></i>

                <span>
                    Document Automation
                </span>

            </div>


        </header>



        <!-- =================================================
             MAIN CONTENT
             ================================================= -->

        <main class="main-content">


            <!-- =================================================
                 HERO / LEFT SIDE
                 ================================================= -->

            <section class="hero-section">


                <div class="eyebrow">

                    DOCUMENT AUTOMATION

                </div>


                <h1>

                    Create documents.

                    <span>
                        In bulk. Effortlessly.
                    </span>

                </h1>


                <p class="hero-description">

                    Turn your Excel or CSV data into professional,
                    personalized documents without repetitive
                    manual work.

                </p>



                <!-- =================================================
                     FEATURES
                     ================================================= -->

                <div class="features">


                    <!-- Feature 1 -->

                    <div class="feature">

                        <div class="feature-icon icon-blue">

                            <i class="fas fa-layer-group"></i>

                        </div>


                        <div class="feature-content">

                            <h3>
                                Choose a template
                            </h3>

                            <p>
                                Start with a professional template
                                or create your own document design.
                            </p>

                        </div>

                    </div>



                    <!-- Feature 2 -->

                    <div class="feature">

                        <div class="feature-icon icon-purple">

                            <i class="fas fa-database"></i>

                        </div>


                        <div class="feature-content">

                            <h3>
                                Add your data
                            </h3>

                            <p>
                                Upload your Excel or CSV file and
                                easily map your document fields.
                            </p>

                        </div>

                    </div>



                    <!-- Feature 3 -->

                    <div class="feature">

                        <div class="feature-icon icon-green">

                            <i class="fas fa-file-signature"></i>

                        </div>


                        <div class="feature-content">

                            <h3>
                                Personalize automatically
                            </h3>

                            <p>
                                Fill every document with the correct
                                information from your data.
                            </p>

                        </div>

                    </div>



                    <!-- Feature 4 -->

                    <div class="feature">

                        <div class="feature-icon icon-orange">

                            <i class="fas fa-file-pdf"></i>

                        </div>


                        <div class="feature-content">

                            <h3>
                                Generate PDFs
                            </h3>

                            <p>
                                Create hundreds of professional
                                personalized documents in seconds.
                            </p>

                        </div>

                    </div>



                    <!-- Feature 5 -->

                    <div class="feature">

                        <div class="feature-icon icon-pink">

                            <i class="fas fa-download"></i>

                        </div>


                        <div class="feature-content">

                            <h3>
                                Download everything
                            </h3>

                            <p>
                                Download individual documents,
                                merged PDFs or complete ZIP files.
                            </p>

                        </div>

                    </div>


                </div>


            </section>



            <!-- =================================================
                 LOGIN / RIGHT SIDE
                 ================================================= -->

            <section class="login-section">


                <div class="login-card">


                    <!-- Subtle decorative glow -->

                    <div class="login-card-glow"></div>


                    <div class="login-content">


                        <!-- =================================================
                             LOGIN HEADER
                             ================================================= -->

                        <div class="login-heading">

                            <div class="login-icon">

                                <i class="fas fa-user"></i>

                            </div>


                            <h2>
                                Login
                            </h2>

                        </div>


                        <div class="login-line"></div>



                        <!-- =================================================
                             LOGIN FORM
                             ================================================= -->

                        <form method="post"
                              asp-controller="Account"
                              asp-action="Login">

                            @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })


                            <!-- =================================================
                                 BUSINESS NAME
                                 ================================================= -->

                            <div class="mb-4">

                                <label for="businessName"
                                       class="form-label">

                                    Business Name

                                </label>


                                <div class="input-group">


                                    <span class="input-group-text">

                                        <i class="fas fa-building"></i>

                                    </span>


                                    <input type="text"
                                           id="businessName"
                                           name="businessName"
                                           class="form-control form-control-lg"
                                           placeholder="Enter your business name"
                                           autocomplete="organization"
                                           required />


                                </div>

                            </div>



                            <!-- =================================================
                                 EMAIL
                                 ================================================= -->

                            <div class="mb-4">

                                <label for="email"
                                       class="form-label">

                                    Email

                                </label>


                                <div class="input-group">


                                    <span class="input-group-text">

                                        <i class="fas fa-envelope"></i>

                                    </span>


                                    <input type="email"
                                           id="email"
                                           name="email"
                                           class="form-control form-control-lg"
                                           placeholder="you@example.com"
                                           autocomplete="email"
                                           required />


                                </div>

                            </div>



                            <!-- =================================================
                                 PASSWORD
                                 ================================================= -->

                            <div class="mb-4">

                                <label for="password"
                                       class="form-label">

                                    Password

                                </label>


                                <div class="input-group">


                                    <span class="input-group-text">

                                        <i class="fas fa-lock"></i>

                                    </span>


                                    <input type="password"
                                           id="password"
                                           name="password"
                                           class="form-control form-control-lg"
                                           placeholder="Enter your password"
                                           autocomplete="current-password"
                                           required />


                                    <button type="button"
                                            class="input-group-text password-toggle"
                                            id="togglePassword"
                                            aria-label="Show password">

                                        <i class="fas fa-eye"></i>

                                    </button>


                                </div>

                            </div>



                            <!-- =================================================
                                 LOGIN BUTTON
                                 ================================================= -->

                            <button type="submit"
                                    class="btn btn-primary btn-lg w-100 login-button">


                                <span>
                                    Login
                                </span>


                                <i class="fas fa-arrow-right"></i>


                            </button>



                            <!-- =================================================
                                 REMEMBER / FORGOT
                                 ================================================= -->

                            <div class="login-options">


                                <div class="form-check">


                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="rememberMe"
                                           name="rememberMe" />


                                    <label class="form-check-label"
                                           for="rememberMe">

                                        Remember me

                                    </label>


                                </div>


                                <a href="#">
                                    Forgot password?
                                </a>


                            </div>


                        </form>



                        <!-- Divider -->

                        <div class="login-divider"></div>



                        <!-- Register -->

                        <div class="register-text">

                            Don't have an account?

                            <a href="/Account/Register">
                                Create one
                            </a>

                        </div>


                    </div>


                </div>


            </section>


        </main>



        <!-- =================================================
             FOOTER
             ================================================= -->

        <footer class="footer">


            <span>

                © @DateTime.UtcNow.Year
                DocGenie. All rights reserved.

            </span>


            <span class="footer-separator"></span>


            <a href="#">
                Privacy
            </a>


            <span class="footer-separator"></span>


            <a href="#">
                Terms
            </a>


        </footer>


    </div>



    <!-- =====================================================
         PASSWORD TOGGLE
         ===================================================== -->

    <script>

            const passwordInput =
                document.getElementById("password");

            const togglePassword =
                document.getElementById("togglePassword");


            if (togglePassword && passwordInput) {

                togglePassword.addEventListener(
                    "click",
                    function() {

                        const isPassword =
                            passwordInput.type === "password";


                        passwordInput.type =
                            isPassword
                                ? "text"
                                : "password";


                        const icon =
                            this.querySelector("i");


                        icon.classList.toggle(
                            "fa-eye",
                            !isPassword
                        );


                        icon.classList.toggle(
                            "fa-eye-slash",
                            isPassword
                        );

                    }
                );

            }

    </script>


</body>

</html>
